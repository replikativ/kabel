{:paths ["src" "target/classes"]
 :deps/prep-lib {:alias :build
                 :fn compile-java
                 :ensure "target/classes"}
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        ;; A released coordinate now that boring is on Clojars. This was
        ;; :local/root because an earlier pin silently kept a stale locally
        ;; installed build -- kabel's tests passed against a boring several
        ;; wire fixes behind the one konserve and datahike ran, which is the
        ;; worst case: green CI on a version nothing else in the stack uses.
        ;; A Clojars coordinate cannot drift that way.
        org.replikativ/boring {:mvn/version "0.1.4"}
        org.replikativ/superv.async {:mvn/version "0.3.50"}
        com.cognitect/transit-clj {:mvn/version "1.0.333"}
        com.cognitect/transit-cljs {:mvn/version "0.8.280"}
        cheshire/cheshire {:mvn/version "5.13.0"}
        org.replikativ/incognito {:mvn/version "0.3.69"}
        org.replikativ/hasch {:mvn/version "0.4.100"}
        org.replikativ/logging {:mvn/version "0.1.3"}
        org.clojure/data.fressian {:mvn/version "1.0.0"}
        com.github.pkpkpk/fress {:mvn/version "0.4.312"}
        http-kit/http-kit {:mvn/version "2.8.0"}
        org.glassfish.tyrus/tyrus-core {:mvn/version "1.13.1"}
        org.glassfish.tyrus/tyrus-client {:mvn/version "1.13.1"}
        org.glassfish.tyrus/tyrus-container-grizzly-client {:mvn/version "1.13.1"}}
 ;; ClojureScript lives in :dev, NOT in :deps. It is a compile-time tool, and as
 ;; a top-level dependency kabel imposed its version on every consumer -- which is
 ;; how konserve-sync ended up with closure-library 0.0-20250515 against an older
 ;; closure-compiler, a pairing that compiles cleanly and then dies at runtime.
 :aliases {:dev {:extra-deps {org.clojure/clojurescript {:mvn/version "1.12.145"}
                              thheller/shadow-cljs {:mvn/version "3.4.11"}}}
           ;; Bundle-size probes: one entry point per codec, so an :advanced
           ;; build measures what a consumer of THAT codec actually ships.
           :bench {:extra-paths ["bench/src"]}
           ;; Optional auth subsystem (kabel.auth.*) — kept off the base graph so
           ;; a non-auth kabel user pulls no JSON/JWT/password deps.
           :auth {:extra-deps {metosin/jsonista {:mvn/version "1.0.0"}
                               buddy/buddy-hashers {:mvn/version "2.0.167"}
                               ;; portable crypto (HS256 verify on JVM + CLJS).
                               org.replikativ/geheimnis {:mvn/version "0.2.33"}}}
           ;; The datahike-backed AuthStore (kabel.auth.store.datahike) — datahike
           ;; is the consumer's to provide; pinned to the stack's main here for tests.
           ;; datahike is the consumer's to provide. For kabel's own store tests we
           ;; overlay the co-developed checkout (already prepped, tracks the stack's
           ;; main); a release swaps this for a Maven datahike coordinate.
           :auth-store-datahike {:extra-deps {org.replikativ/datahike {:local/root "../datahike"}}}
           ;; The DEFAULT http-kit dependency stays the release. Only the test
           ;; alias overrides it, to the commit carrying permessage-deflate
           ;; (http-kit/http-kit#617, not yet released). The client extension is
           ;; ours and the server half is http-kit's; running them against each
           ;; other is the only way to learn whether we agree about the wire
           ;; format rather than merely agreeing with ourselves -- and it
           ;; immediately found an RFC 7692 7.2.3.6 violation both of them had.
           ;;
           ;; http-kit is a lein project, so its git dep must be prepped before
           ;; the classpath will build -- and it has to name the alias, because
           ;; the override lives in one:
           ;;
           ;;   clojure -X:deps prep :aliases '[:test]'      (needs lein)
           ;;
           ;; The tests skip with a message rather than passing vacuously if
           ;; the class is absent. Drop this override once a release carries
           ;; the extension.
           :test {:extra-paths ["test"]
                  :override-deps
                  {http-kit/http-kit
                   {:git/url "https://github.com/whilo/http-kit"
                    :git/sha "1b9924edea5a29cc692031bf1e52ff87385d0aaa"}}
                  :extra-deps {org.clojure/test.check {:mvn/version "0.9.0"}
                               io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :exec-fn cognitect.test-runner.api/test
                  :exec-args {:dirs ["test"]}}
           :pingpong {:extra-paths ["examples"]
                      :main-opts ["-m" "kabel.examples.pingpong"]}
           :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}
                          slipset/deps-deploy {:mvn/version "0.2.2"}}
                   :ns-default build}
           :format {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
                    :main-opts ["-m" "cljfmt.main" "check"]}
           :ffix {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
                  :main-opts ["-m" "cljfmt.main" "fix"]}}}
